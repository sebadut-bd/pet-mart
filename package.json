        "webpack": "^5.75.0",
        "webpack-cli": "^4.10.0"
    },
    "dependencies": {
        "@deveodk/vue-toastr": "^1.1.0",
        "apexcharts": "^3.37.2",
        "vue": "^2.6.14",
        "vue-apexcharts": "^1.7.0",
        "vue-axios": "^3.3.7",
        "vue-router": "^3.5.2",
        "vue-sweetalert2": "^3.0.6",
